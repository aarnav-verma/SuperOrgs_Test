DATABASE_URL=postgresql://postgres:postgres@db:5432/federal_ai_mission_control

# ── AI Provider ─────────────────────────────────────────────────────────────
# Set AI_PROVIDER to "openai" or "anthropic".
# Fill in ONLY the key for the provider you chose — the other can stay blank.
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Optional ─────────────────────────────────────────────────────────────────
# Increase if Postgres is slow to start on your machine (milliseconds).
DB_WAIT_TIMEOUT_MS=120000
